<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<AssemblyName>KeetaNet.Anchor</AssemblyName>
		<RootNamespace>KeetaNet.Anchor</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsPackable>true</IsPackable>
		<PackageId>KeetaNet.Anchor</PackageId>
		<Description>KeetaNet anchor client SDK (KYC, asset movement, crypto, certificates, containers) over a sandboxed WebAssembly core.</Description>
		<PackageTags>keeta;keetanet;anchor;kyc;asset-movement;wasm</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Wasmtime" />
	</ItemGroup>

	<ItemGroup>
		<!-- Only for the debug leak counter, which has no public surface. -->
		<InternalsVisibleTo Include="KeetaNet.Anchor.Tests" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="wasm/keetanetwork_anchor_client_wasi.wasm" LogicalName="KeetaNet.Anchor.keetanetwork_anchor_client_wasi.wasm" />
	</ItemGroup>

	<Target Name="EnsureWasmCorePresent" BeforeTargets="PrepareForBuild">
		<Error
			Condition="!Exists('wasm/keetanetwork_anchor_client_wasi.wasm')"
			Text="The P1 wasm core is missing. Run `make wasm` to build it from the pinned crates.io release." />
	</Target>

</Project>
